{
  "name": "rocket-on-air-sensor",
  "version": "0.1.0",
  "private": true,
  "description": "Detect call state on the Mac and drive a remote on-air light. Four parts, one verify command.",
  "type": "module",
  "workspaces": [
    "server",
    "admin-ui",
    "companion-module"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "firmware:config": "make -C firmware config",
    "firmware:setup": "make -C firmware setup",
    "firmware:compile": "make -C firmware compile",
    "verify": "npm run check --workspaces --if-present && npm run test --workspaces --if-present && npm run test:deploy && npm run firmware:config",
    "test:deploy": "bash deploy/test-update.sh"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.23.8",
    "typescript": "^7.0.2"
  }
}
