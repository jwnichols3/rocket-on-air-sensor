# session/scratch
.remember/
tmp/

# macOS
.DS_Store

# Claude local settings (machine-local; agentcore.json is committed when it exists)
.claude/settings.local.json

# common build/dep dirs (language TBD - prune when stack is chosen)
node_modules/
.venv/
__pycache__/
dist/
build/
.env
.env.local
*.log

# onair update working dirs (deploy/onair): staged build, previous-good
# build kept for rollback, failed build kept for diagnosis
.dist-next/
dist.prev/
.dist-failed/

# firmware/ (the ESPHome lab, imported by D-37). The build cache is large and
# machine-local; secrets.yaml holds the D-17 device credentials and never lands
# in a public repo - secrets.yaml.example is what is committed.
firmware/.esphome/
firmware/configs/.esphome/
firmware/configs/secrets.yaml
firmware/configs/.device-builder*

# Built by `npm run build -w admin-ui` from admin-ui/src. Generated, never edited.
server/public/admin/index.html

# The same bundle, copied to where the PRE-MIGRATION plist resolves it. The installed
# plist still runs $APPDIR/dist/index.js (see D-47), so the server looks for the console at
# $APPDIR/public/admin/. `sudo deploy/onair update` moves the entry point under server/,
# after which this copy is dead and can be deleted.
/public/admin/
