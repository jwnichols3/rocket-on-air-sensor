# session/scratch
.remember/
tmp/

# macOS
.DS_Store

# Claude local settings (machine-local; agentcore.json is committed when it exists)
.claude/settings.local.json

# common build/dep dirs (language TBD - prune when stack is chosen)
node_modules/
.venv/
__pycache__/
dist/
build/
.env
.env.local
*.log

# onair update working dirs (deploy/onair): staged build, previous-good
# build kept for rollback, failed build kept for diagnosis
.dist-next/
dist.prev/
.dist-failed/

# firmware/ (the ESPHome lab, imported by D-37). The build cache is large and
# machine-local; secrets.yaml holds the D-17 device credentials and never lands
# in a public repo - secrets.yaml.example is what is committed.
firmware/.esphome/
firmware/configs/.esphome/
firmware/configs/secrets.yaml
firmware/configs/.device-builder*
