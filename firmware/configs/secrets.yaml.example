wifi_ssid: "YOUR_2_4_GHZ_WIFI_NAME"
wifi_password: "YOUR_WIFI_PASSWORD"
fallback_ap_password: "GENERATE_A_PASSWORD_OF_AT_LEAST_8_CHARACTERS"
api_encryption_key: "GENERATE_WITH: openssl rand -base64 32"

web_server_password: "GENERATE_WITH: openssl rand -base64 24"

# Where the panel pulls its state table from (#43). These are DEFAULTS baked into the
# firmware for a first boot; after that the device's own ServerHost / ServerPassphrase
# entities hold the live values in NVS and survive a reflash of these.
onair_server_host: "10.0.0.2"
onair_passphrase: "THE ONAIR PASSPHRASE - ~/.onair/config.json, auth.passphrase"
