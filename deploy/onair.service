[Unit]
Description=On-air API service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# %i templating only works for onair@.service (template units) - this is a plain
# unit file, so set the real user directly (e.g. "pi").
User=pi
Environment=ONAIR_PORT=8484
# Environment=ONAIR_TOKEN=change-me
# ExecStart: Every restart re-resolves and rebuilds from git. A transient network
# blip can trigger systemd's default StartLimitBurst (5 restarts in 10s) and mark
# the unit permanently failed until 'systemctl reset-failed'. Consider adding
# StartLimitIntervalSec=0 to disable the limit, or installing a pinned build
# locally instead of npx'ing from git.
# Note: npx wraps the real node process; graceful shutdown depends on npm
# forwarding SIGTERM to the child (works in practice, noted for transparency).
ExecStart=/usr/bin/env npx --yes github:jwnichols3/rocket-on-air-sensor
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
