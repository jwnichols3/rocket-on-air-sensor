#!/usr/bin/env bash
# onair - install/manage the on-air API as a macOS launchd LaunchDaemon.
#
# Modern launchctl subcommands only (bootstrap/bootout/kickstart/print/enable/
# disable) - never the legacy load/unload. See docs/mac-setup.md.
set -euo pipefail

LABEL=com.rocket.onair
T="system/$LABEL"
PLIST_PATH="/Library/LaunchDaemons/$LABEL.plist"
NEWSYSLOG_CONF="/etc/newsyslog.d/onair.conf"
SUDOERS_FILE="/etc/sudoers.d/onair"
BIN_LINK="/usr/local/bin/onair"
LAUNCHCTL="/bin/launchctl"

# --- resolve the real app checkout, even through the /usr/local/bin/onair symlink ---
resolve_script_path() {
  local source="${BASH_SOURCE[0]}" dir
  while [[ -h "$source" ]]; do
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    if [[ "$source" != /* ]]; then source="$dir/$source"; fi
  done
  cd -P "$(dirname "$source")" && pwd
}
DEPLOY_DIR="$(resolve_script_path)"
APPDIR="$(cd -P "$DEPLOY_DIR/.." && pwd)"
TEMPLATE="$DEPLOY_DIR/com.rocket.onair.plist.template"

# --- resolve the real (non-root) target user + home, whether invoked directly or via sudo ---
CURRENT_USER="$(id -un)"
if [[ "$CURRENT_USER" == "root" && -n "${SUDO_USER:-}" ]]; then TARGET_USER="$SUDO_USER"; else TARGET_USER="$CURRENT_USER"; fi
TARGET_HOME="$(dscl . -read "/Users/$TARGET_USER" NFSHomeDirectory 2>/dev/null | awk '{print $2}')"
if [[ -z "$TARGET_HOME" ]]; then TARGET_HOME="$HOME"; fi

# --- config: a real env var wins over ~/.onair/config.env, which wins over
# the defaults. The config file is NEVER sourced or eval'd (it's user-
# writable, and this runs as root under sudo) - only `KEY=value` lines are
# parsed with grep/cut, with one pair of surrounding quotes stripped. ---
CONFIG_FILE="${ONAIR_CONFIG:-$TARGET_HOME/.onair/config.env}"

# read_config KEY - prints env var KEY if set (non-empty), else the value of
# the LAST matching `^KEY=` line in $CONFIG_FILE with one pair of surrounding
# single/double quotes stripped, else nothing.
read_config() {
  local key="$1" line value
  local env_value="${!key:-}"
  if [[ -n "$env_value" ]]; then
    printf '%s' "$env_value"
    return 0
  fi
  [[ -f "$CONFIG_FILE" ]] || return 0
  line="$(grep "^${key}=" "$CONFIG_FILE" 2>/dev/null | tail -n 1)"
  [[ -n "$line" ]] || return 0
  value="$(printf '%s\n' "$line" | cut -d'=' -f2-)"
  case "$value" in
    \"*\") value="${value#\"}"; value="${value%\"}" ;;
    \'*\') value="${value#\'}"; value="${value%\'}" ;;
  esac
  printf '%s' "$value"
}

# valid_port ARG - true if ARG is an integer in 1-65535.
valid_port() {
  local p="$1"
  [[ "$p" =~ ^[0-9]+$ ]] || return 1
  (( p >= 1 && p <= 65535 ))
}

ONAIR_PORT="$(read_config ONAIR_PORT)"
ONAIR_PORT="${ONAIR_PORT:-8484}"
ONAIR_TOKEN="$(read_config ONAIR_TOKEN)"
STATE_FILE="$(read_config ONAIR_STATE_FILE)"
STATE_FILE="${STATE_FILE:-$TARGET_HOME/.onair/state.json}"
LOG_FILE="$TARGET_HOME/.onair/logs/onair.log"

usage() {
  cat >&2 <<EOF
usage: onair <verb> [args]

verbs:
  install [--sudoers]  render plist, install to launchd, bootstrap (runs
                        setup first if $CONFIG_FILE doesn't exist yet)
  setup [--non-interactive]
                        interactive Q&A for port/token/state file; writes
                        $CONFIG_FILE (0600); restarts if the daemon is up.
                        Re-runnable any time to reconfigure.
  uninstall            bootout, remove plist/newsyslog/symlink/sudoers
  start                bootstrap if not loaded, else kickstart
  stop                 bootout (returns at next boot; see 'disable')
  restart              kickstart -k
  reload               bootout+bootstrap (plist/env changes; kickstart -k
                        alone does not re-read the plist)
  status                supervised + responding two-layer check
  logs [-f]             tail (or follow) $LOG_FILE
  reset-state            clear on-air state via API (or state file), restart
  disable               launchctl disable (persists across reboot)
  enable                launchctl enable, then start
  update [--check-only|--dry-run] [--yes]
                        fetch + fast-forward this checkout, rebuild, swap in
                        the new dist, restart (reload if the node path
                        changed), health-poll; rolls back on failure.
                        --check-only/--dry-run lists pending commits without
                        applying. --yes skips the confirm prompt (implied
                        when stdin is not a TTY). Refuses a dirty tree or a
                        checkout with no upstream branch.

Reads ONAIR_PORT (default 8484) and ONAIR_TOKEN from the environment or
$CONFIG_FILE.
EOF
}

# --- health check: GET /admin/health, token via query string (GET-only auth path) ---
health_url() {
  if [[ -n "$ONAIR_TOKEN" ]]; then
    printf 'http://localhost:%s/admin/health?token=%s' "$ONAIR_PORT" "$ONAIR_TOKEN"
  else
    printf 'http://localhost:%s/admin/health' "$ONAIR_PORT"
  fi
}

health_check_once() {
  curl -fsS -m 2 "$(health_url)" >/dev/null 2>&1
}

# Fetches /admin/health and prints its body, or nothing on failure. Kept
# dependency-free (grep, not a JSON parser) since the only field we care
# about is stateFileWritable.
health_body() {
  curl -fsS -m 2 "$(health_url)" 2>/dev/null
}

# Every mutating verb polls up to 5s and prints PASS/FAIL. Also fails (even
# though the HTTP check passed) when the health body reports
# stateFileWritable:false - that's the daemon-can't-persist-state failure
# mode (e.g. a root-owned ~/.onair from a bad install), and a poll that
# ignores it would report PASS while writes silently fail.
mutating_health_poll() {
  local deadline=$((SECONDS + 5))
  local body
  while (( SECONDS < deadline )); do
    if body="$(health_body)" && [[ -n "$body" ]]; then
      if printf '%s' "$body" | grep -q '"stateFileWritable":false'; then
        echo "health: FAIL (stateFileWritable is false - state directory not writable by the daemon)"
        return 1
      fi
      echo "health: PASS"
      return 0
    fi
    sleep 0.5
  done
  echo "health: FAIL"
  return 1
}

# --- launchctl wrappers ---
sudo_launchctl() {
  sudo "$LAUNCHCTL" "$@"
}

is_loaded() {
  sudo_launchctl print "$T" >/dev/null 2>&1
}

# ensure_target_dir DIR - mkdir -p as TARGET_USER, whether invoked directly
# or via sudo. A plain root-owned mkdir under sudo would leave the directory
# unwritable by the daemon, which always runs as TARGET_USER.
ensure_target_dir() {
  local dir="$1"
  if [[ "$(id -u)" -eq 0 ]]; then
    sudo -u "$TARGET_USER" mkdir -p "$dir"
  else
    mkdir -p "$dir"
  fi
}

# One-time migration: the config file used to be ~/.onair/cli.env. If it
# exists and the new ~/.onair/config.env doesn't, copy it over (owner
# TARGET_USER, mode 0600) and say so. cli.env is not read after this.
migrate_cli_env() {
  local cli_env="$TARGET_HOME/.onair/cli.env"
  local config_env="$TARGET_HOME/.onair/config.env"
  if [[ -f "$cli_env" && ! -f "$config_env" ]]; then
    install -o "$TARGET_USER" -m 0600 "$cli_env" "$config_env"
    echo "onair: migrated $cli_env to $config_env"
  fi
}

# render_plist - render the plist template (node/APPDIR/user/home
# placeholders), lint it, and install it to $PLIST_PATH (0644 root:wheel).
# Factored out of cmd_install so `onair update`'s node-path-changed path
# (step 7) can re-render without going through cmd_install's full flow
# (wizard-on-first-run, sudoers, bootstrap-start).
render_plist() {
  local node_bin
  node_bin="$(command -v node || true)"
  if [[ -z "$node_bin" ]]; then
    echo "onair: node not found in PATH - install failed" >&2
    exit 1
  fi

  if [[ ! -f "$TEMPLATE" ]]; then
    echo "onair: template not found at $TEMPLATE" >&2
    exit 1
  fi

  local sub_value
  for sub_value in "$node_bin" "$APPDIR" "$TARGET_USER" "$TARGET_HOME"; do
    if [[ "$sub_value" == *'&'* || "$sub_value" == *'|'* || "$sub_value" == *'\'* ]]; then
      echo "onair: path contains characters the installer cannot render safely" >&2
      exit 1
    fi
  done

  local tmp_plist
  tmp_plist="$(mktemp /tmp/com.rocket.onair.plist.XXXXXX)"
  # This is the exact sed pipeline used to render the template; verification
  # reproduces it byte-for-byte against a scratch dir.
  sed \
    -e "s|@NODE@|$node_bin|g" \
    -e "s|@APPDIR@|$APPDIR|g" \
    -e "s|@USER@|$TARGET_USER|g" \
    -e "s|@HOME@|$TARGET_HOME|g" \
    "$TEMPLATE" > "$tmp_plist"

  if ! plutil -lint "$tmp_plist" >/dev/null; then
    echo "onair: rendered plist failed plutil -lint" >&2
    rm -f "$tmp_plist"
    exit 1
  fi

  sudo install -o root -g wheel -m 0644 "$tmp_plist" "$PLIST_PATH"
  rm -f "$tmp_plist"
}

# run_as_invoking_user CMD... - runs CMD as $SUDO_USER when this script is
# running as root under sudo (so `onair update`'s git/npm/build steps don't
# leave root-owned files in the checkout); runs it directly otherwise. -H so
# npm/node/git see the invoking user's HOME, not root's. Mirrors
# deploy/bootstrap's helper of the same name.
run_as_invoking_user() {
  if [[ "$(id -u)" -eq 0 && -n "${SUDO_USER:-}" ]]; then
    sudo -u "$SUDO_USER" -H "$@"
  else
    "$@"
  fi
}

# git_u ARGS... - git against $APPDIR, run as the invoking (non-root) user.
git_u() {
  run_as_invoking_user git -C "$APPDIR" "$@"
}

# dist_is_current - true if $APPDIR/dist exists and no file under
# $APPDIR/src has a newer mtime than it.
dist_is_current() {
  [[ -d "$APPDIR/dist" ]] || return 1
  local newer
  newer="$(find "$APPDIR/src" -type f -newer "$APPDIR/dist" 2>/dev/null)"
  [[ -z "$newer" ]]
}

# ---------------------------------------------------------------------------
cmd_install() {
  local sudoers_flag="${1:-}"
  # Create as TARGET_USER, not root: install runs under sudo, so a plain
  # `mkdir -p` here would leave ~/.onair root-owned and the daemon (which runs
  # as TARGET_USER) unable to write state. Works both invoked via sudo (EUID
  # 0, TARGET_USER set from SUDO_USER) and run directly (EUID != 0, plain mkdir).
  ensure_target_dir "$TARGET_HOME/.onair/logs"

  migrate_cli_env

  # A fresh install with no config.env yet (and nothing to migrate from
  # cli.env) gets the wizard before the daemon ever starts, so the first
  # boot already uses the chosen values instead of defaults. Interactive
  # only on a TTY - cmd_setup makes that call itself.
  if [[ ! -f "$CONFIG_FILE" ]]; then
    cmd_setup __internal_from_install__
  fi

  render_plist

  write_newsyslog_conf

  sudo ln -sf "$DEPLOY_DIR/onair" "$BIN_LINK"

  sudo_launchctl bootstrap system "$PLIST_PATH"

  if [[ "$sudoers_flag" == "--sudoers" ]]; then
    install_sudoers
  fi

  mutating_health_poll
}

write_newsyslog_conf() {
  local tmp
  tmp="$(mktemp /tmp/onair.newsyslog.XXXXXX)"
  cat > "$tmp" <<EOF
# logfilename                          [owner:group]    mode count size  when  flags
$LOG_FILE   $TARGET_USER:staff       644  5     10000 *     J
EOF
  sudo install -o root -g wheel -m 0644 "$tmp" "$NEWSYSLOG_CONF"
  rm -f "$tmp"
}

install_sudoers() {
  local tmp
  tmp="$(mktemp /tmp/onair.sudoers.XXXXXX)"
  cat > "$tmp" <<EOF
# Managed by 'onair install --sudoers'. Scopes passwordless sudo to exactly the
# launchctl subcommands the onair CLI issues against $LABEL - nothing broader.
# Remove with: sudo rm $SUDOERS_FILE
$TARGET_USER ALL=(root) NOPASSWD: $LAUNCHCTL bootstrap system $PLIST_PATH, \\
  $LAUNCHCTL bootout $T, \\
  $LAUNCHCTL kickstart $T, \\
  $LAUNCHCTL kickstart -k $T, \\
  $LAUNCHCTL print $T, \\
  $LAUNCHCTL enable $T, \\
  $LAUNCHCTL disable $T
EOF
  if ! visudo -cf "$tmp" >/dev/null; then
    echo "onair: generated sudoers file failed visudo -cf, not installing" >&2
    rm -f "$tmp"
    exit 1
  fi
  sudo install -o root -g wheel -m 0440 "$tmp" "$SUDOERS_FILE"
  rm -f "$tmp"
}

cmd_setup() {
  local non_interactive=false
  local from_install=false
  local a
  for a in "$@"; do
    case "$a" in
      --non-interactive) non_interactive=true ;;
      __internal_from_install__) from_install=true ;;
      *)
        echo "onair: setup: unknown argument: $a" >&2
        exit 1
        ;;
    esac
  done

  ensure_target_dir "$(dirname "$CONFIG_FILE")"
  migrate_cli_env

  # Current effective values (env > config file > built-in default). Read
  # fresh here since migrate_cli_env may have just created config.env.
  local cur_port cur_token cur_state
  cur_port="$(read_config ONAIR_PORT)"; cur_port="${cur_port:-8484}"
  cur_token="$(read_config ONAIR_TOKEN)"
  cur_state="$(read_config ONAIR_STATE_FILE)"; cur_state="${cur_state:-$TARGET_HOME/.onair/state.json}"

  local new_port="$cur_port" new_token="$cur_token" new_state="$cur_state"

  local interactive=false
  if [[ -t 0 && "$non_interactive" != "true" ]]; then
    interactive=true
  fi

  if [[ "$interactive" == "true" ]]; then
    local ans

    # `read -r` returns nonzero on EOF; under `set -e` that would kill the
    # script mid-wizard if stdin closes early, so every read is guarded with
    # `|| true` and validated afterward instead of trusted to succeed.

    while true; do
      read -r -p "Port [$cur_port]: " ans || true
      ans="${ans:-$cur_port}"
      if valid_port "$ans"; then
        new_port="$ans"
        break
      fi
      echo "onair: invalid port '$ans' - must be an integer 1-65535" >&2
    done

    local default_choice="k"
    [[ -z "$cur_token" ]] && default_choice="n"
    while true; do
      read -r -p "Token [k]eep/[g]enerate/[e]nter/[n]one ($default_choice): " ans || true
      ans="${ans:-$default_choice}"
      case "$ans" in
        k|K) new_token="$cur_token"; break ;;
        g|G) new_token="$(uuidgen | tr 'A-Z' 'a-z')"; break ;;
        e|E) read -r -p "Enter token: " new_token || true; break ;;
        n|N) new_token=""; break ;;
        *) echo "onair: invalid choice '$ans' - enter k, g, e, or n" >&2 ;;
      esac
    done

    read -r -p "State file [$cur_state]: " ans || true
    new_state="${ans:-$cur_state}"
  fi

  # Was the daemon reachable before config.env changes under it? Probed with
  # curl (health_check_once), deliberately NOT is_loaded/launchctl - launchctl
  # needs sudo, and setup must stay sudo-free when the daemon is down. This
  # uses the CURRENT $ONAIR_PORT/$ONAIR_TOKEN (read at script startup, before
  # this function reassigns them below), i.e. what the daemon is actually
  # listening on right now.
  local daemon_was_up=false
  if health_check_once; then
    daemon_was_up=true
  fi

  local tmp_config
  tmp_config="$(mktemp /tmp/onair.config.XXXXXX)"
  cat > "$tmp_config" <<EOF
# $CONFIG_FILE - onair service configuration.
# Managed by 'onair setup' (rerun any time to change these values). Real
# environment variables override the values below.
ONAIR_PORT="$new_port"
ONAIR_TOKEN="$new_token"
ONAIR_STATE_FILE="$new_state"
EOF
  install -o "$TARGET_USER" -m 0600 "$tmp_config" "$CONFIG_FILE"
  rm -f "$tmp_config"
  echo "onair: wrote $CONFIG_FILE"

  # The rest of this run (restart/health-poll below, or cmd_install's own
  # flow if we were called from there) should see the values just written.
  ONAIR_PORT="$new_port"
  ONAIR_TOKEN="$new_token"
  STATE_FILE="$new_state"

  if [[ "$from_install" == "true" ]]; then
    return 0
  fi

  if [[ "$daemon_was_up" == "true" ]]; then
    cmd_restart
  else
    echo "onair: daemon not responding - check 'onair status' and 'onair logs'; if it's not installed yet, run 'sudo onair install'"
  fi
}

cmd_uninstall() {
  if is_loaded; then
    sudo_launchctl bootout "$T"
  fi
  sudo rm -f "$PLIST_PATH" "$NEWSYSLOG_CONF" "$SUDOERS_FILE" "$BIN_LINK"
  mutating_health_poll || true
}

cmd_start() {
  if is_loaded; then
    sudo_launchctl kickstart "$T"
  else
    sudo_launchctl bootstrap system "$PLIST_PATH"
  fi
  mutating_health_poll
}

cmd_stop() {
  sudo_launchctl bootout "$T"
  echo "returns at next boot; use \`onair disable\` for persistent off"
  mutating_health_poll || true
}

cmd_restart() {
  sudo_launchctl kickstart -k "$T"
  mutating_health_poll
}

cmd_reload() {
  echo "reload: 'kickstart -k' restarts the process but does not re-read the" >&2
  echo "plist from disk; reload does bootout+bootstrap so plist/env changes" >&2
  echo "(e.g. after re-running install) actually take effect." >&2
  if is_loaded; then
    sudo_launchctl bootout "$T"
  fi
  sudo_launchctl bootstrap system "$PLIST_PATH"
  mutating_health_poll
}

cmd_status() {
  local supervised=no state="unknown" pid="unknown" last_exit="unknown" disabled="unknown"
  local print_out=""
  # -n: never prompt for a password. Without a cached/NOPASSWD sudo ticket,
  # status degrades to "supervised: unknown" instead of hanging or exiting 1.
  if print_out="$(sudo -n "$LAUNCHCTL" print "$T" 2>/dev/null)"; then
    supervised=yes
    state="$(printf '%s\n' "$print_out" | awk -F' = ' '/^[[:space:]]*state = /{print $2; exit}')"
    pid="$(printf '%s\n' "$print_out" | awk -F' = ' '/^[[:space:]]*pid = /{print $2; exit}')"
    last_exit="$(printf '%s\n' "$print_out" | awk -F' = ' '/last exit (code|status) = /{print $2; exit}')"
    if printf '%s\n' "$print_out" | grep -qE 'disabled = (1|true)'; then
      disabled=yes
    elif printf '%s\n' "$print_out" | grep -qE 'disabled = (0|false)'; then
      disabled=no
    fi
    [[ -z "$state" ]] && state="unknown" || true
    [[ -z "$pid" ]] && pid="unknown" || true
    [[ -z "$last_exit" ]] && last_exit="unknown" || true
  fi

  local responding=no
  if health_check_once; then
    responding=yes
  fi

  echo "supervised: $supervised (state=$state pid=$pid last-exit=$last_exit disabled=$disabled)"
  echo "responding: $responding"

  # Only both layers down counts as failure - a not-yet-installed/unauthorized
  # daemon that's still answering on the port (e.g. run by hand) is healthy.
  if [[ "$supervised" == no && "$responding" == no ]]; then
    return 1
  fi
  return 0
}

cmd_logs() {
  local follow="${1:-}"
  if [[ ! -f "$LOG_FILE" ]]; then
    echo "onair: no log file at $LOG_FILE yet" >&2
    exit 1
  fi
  if [[ "$follow" == "-f" ]]; then
    tail -f "$LOG_FILE"
  else
    tail -n 100 "$LOG_FILE"
  fi
}

cmd_reset_state() {
  if health_check_once; then
    local -a auth=()
    if [[ -n "$ONAIR_TOKEN" ]]; then
      auth=(-H "Authorization: Bearer $ONAIR_TOKEN")
    fi
    # "${auth[@]+"${auth[@]}"}" (not bare "${auth[@]}"): bash 3.2 - macOS's
    # /bin/bash - throws "unbound variable" expanding an empty array under
    # `set -u` without this guard.
    curl -fsS -m 2 -X POST "${auth[@]+"${auth[@]}"}" "http://localhost:$ONAIR_PORT/off" >/dev/null || true
    curl -fsS -m 2 -X DELETE "${auth[@]+"${auth[@]}"}" "http://localhost:$ONAIR_PORT/message" >/dev/null || true
  else
    rm -f "$STATE_FILE"
  fi
  sudo_launchctl kickstart -k "$T"
  mutating_health_poll
}

cmd_disable() {
  sudo_launchctl disable "$T"
  mutating_health_poll || true
}

cmd_enable() {
  sudo_launchctl enable "$T"
  cmd_start
}

# apply_restart_for_update - steps 7-8 of `onair update`: on Mac, if the
# node path baked into the installed plist no longer matches `command -v
# node` (e.g. a Homebrew node upgrade), re-render the plist and reload;
# otherwise a plain restart. Both cmd_reload and cmd_restart already end in
# mutating_health_poll (PASS/FAIL printed there) - this function's exit
# status IS the health-poll result, for cmd_update to branch on.
apply_restart_for_update() {
  if [[ "$(uname -s)" == "Darwin" ]]; then
    local installed_node="" current_node
    if [[ -f "$PLIST_PATH" ]]; then
      installed_node="$(/usr/libexec/PlistBuddy -c 'Print :ProgramArguments:0' "$PLIST_PATH" 2>/dev/null || true)"
    fi
    current_node="$(command -v node || true)"
    if [[ -n "$installed_node" && -n "$current_node" && "$installed_node" != "$current_node" ]]; then
      echo "onair: update: node path changed ($installed_node -> $current_node) - re-rendering plist and reloading" >&2
      render_plist
      cmd_reload
      return
    fi
  fi
  cmd_restart
}

# cmd_update [--check-only|--dry-run] [--yes] - self-update: fetch, fast-
# forward if behind, rebuild into a staging dir, swap it in, restart
# (reload if the node path changed), health-poll, roll back on failure. See
# docs/superpowers/specs/2026-08-06-host-install-evolvable-design.md
# Deliverable 5 for the numbered steps this mirrors.
cmd_update() {
  local check_only=false yes=false
  local a
  for a in "$@"; do
    case "$a" in
      --check-only|--dry-run) check_only=true ;;
      --yes) yes=true ;;
      *)
        echo "onair: update: unknown argument: $a" >&2
        exit 1
        ;;
    esac
  done
  # Non-interactive invocations (cron, CI, a pipe) can't answer a confirm
  # prompt - treat as if --yes were passed rather than hang.
  [[ -t 0 ]] || yes=true

  if ! git_u rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "onair: update: $APPDIR is not a git checkout - can't self-update" >&2
    exit 1
  fi
  if ! git_u rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    echo "onair: update: no upstream tracking branch configured for the current branch in $APPDIR - can't self-update" >&2
    exit 1
  fi

  # Step 1: refuse a dirty tree - staged or unstaged changes to tracked
  # files (untracked files don't block a fast-forward merge, so they're not
  # treated as blocking here).
  local dirty
  dirty="$( { git_u diff --name-only; git_u diff --cached --name-only; } | sort -u )"
  if [[ -n "$dirty" ]]; then
    echo "onair: update: refusing - working tree has uncommitted changes:" >&2
    printf '%s\n' "$dirty" >&2
    exit 1
  fi

  # Step 2: fetch, then check both "no new commits" and "dist is current" -
  # a stale/missing dist with no new commits still needs a rebuild, just
  # without a merge first.
  git_u fetch --quiet origin

  local head_rev upstream_rev
  head_rev="$(git_u rev-parse @)"
  upstream_rev="$(git_u rev-parse '@{u}')"

  if [[ "$head_rev" == "$upstream_rev" ]] && dist_is_current; then
    echo "Everything is up to date."
    exit 0
  fi

  # Step 3: --check-only/--dry-run stops here, before touching anything.
  if [[ "$check_only" == "true" ]]; then
    local log
    log="$(git_u log --oneline '@..@{u}')"
    if [[ -n "$log" ]]; then
      printf '%s\n' "$log"
    else
      echo "no new commits"
    fi
    exit 0
  fi

  # Step 4: confirm unless --yes (or non-TTY, handled above).
  if [[ "$yes" != "true" ]]; then
    local ans
    read -r -p "Apply update and restart onair? [y/N] " ans || true
    case "$ans" in
      y|Y|yes|Yes) ;;
      *)
        echo "onair: update: aborted" >&2
        exit 1
        ;;
    esac
  fi

  # Step 5: fast-forward (skip if already at the upstream commit) + npm ci,
  # both as the checkout-owning user even if `update` itself was run via sudo.
  if [[ "$head_rev" != "$upstream_rev" ]]; then
    git_u merge --ff-only '@{u}'
  fi
  ( cd "$APPDIR" && run_as_invoking_user npm ci --ignore-scripts )

  # Step 6: build to a staging dir, then swap it in. The trap here is
  # deliberately scoped to just the swap - if a kill lands between the two
  # `mv`s, $APPDIR/dist would otherwise be left missing entirely.
  rm -rf "$APPDIR/.dist-next"
  ( cd "$APPDIR" && run_as_invoking_user npx tsc -p tsconfig.json --outDir .dist-next )

  trap '
    if [[ ! -d "$APPDIR/dist" && -d "$APPDIR/dist.prev" ]]; then
      echo "onair: update: interrupted mid-swap - restoring dist from dist.prev" >&2
      mv "$APPDIR/dist.prev" "$APPDIR/dist"
    fi
    exit 1
  ' INT TERM ERR
  rm -rf "$APPDIR/dist.prev"
  if [[ -d "$APPDIR/dist" ]]; then
    mv "$APPDIR/dist" "$APPDIR/dist.prev"
  fi
  mv "$APPDIR/.dist-next" "$APPDIR/dist"
  trap - INT TERM ERR

  # Steps 7-8: restart (or reload, if node moved) + health-poll.
  if apply_restart_for_update; then
    return 0
  fi

  # Health failed: roll back to the pre-update build, keep the bad one
  # around for diagnosis, restart once more (best-effort - the update has
  # already failed regardless of whether this second restart's poll passes).
  echo "onair: update: health check failed after update - rolling back" >&2
  if [[ -d "$APPDIR/dist.prev" ]]; then
    rm -rf "$APPDIR/.dist-failed"
    mv "$APPDIR/dist" "$APPDIR/.dist-failed"
    mv "$APPDIR/dist.prev" "$APPDIR/dist"
    echo "onair: update: failed build kept at $APPDIR/.dist-failed for diagnosis" >&2
    apply_restart_for_update || true
  else
    echo "onair: update: no dist.prev to roll back to - $APPDIR/dist left as the failed build" >&2
  fi
  exit 1
}

# ---------------------------------------------------------------------------
if [[ $# -lt 1 ]]; then
  usage
  exit 1
fi

verb="$1"
shift

case "$verb" in
  install) cmd_install "${1:-}" ;;
  setup) cmd_setup "$@" ;;
  uninstall) cmd_uninstall ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_restart ;;
  reload) cmd_reload ;;
  status) cmd_status ;;
  logs) cmd_logs "${1:-}" ;;
  reset-state) cmd_reset_state ;;
  disable) cmd_disable ;;
  enable) cmd_enable ;;
  update) cmd_update "$@" ;;
  *)
    usage
    exit 1
    ;;
esac
