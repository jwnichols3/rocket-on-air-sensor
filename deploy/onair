#!/usr/bin/env bash
# onair - install/manage the on-air API as a macOS launchd LaunchDaemon.
#
# Modern launchctl subcommands only (bootstrap/bootout/kickstart/print/enable/
# disable) - never the legacy load/unload. See docs/mac-setup.md.
set -euo pipefail

LABEL=com.rocket.onair
T="system/$LABEL"
PLIST_PATH="/Library/LaunchDaemons/$LABEL.plist"
NEWSYSLOG_CONF="/etc/newsyslog.d/onair.conf"
SUDOERS_FILE="/etc/sudoers.d/onair"
BIN_LINK="/usr/local/bin/onair"
LAUNCHCTL="/bin/launchctl"

# --- resolve the real app checkout, even through the /usr/local/bin/onair symlink ---
resolve_script_path() {
  local source="${BASH_SOURCE[0]}" dir
  while [[ -h "$source" ]]; do
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    if [[ "$source" != /* ]]; then source="$dir/$source"; fi
  done
  cd -P "$(dirname "$source")" && pwd
}
DEPLOY_DIR="$(resolve_script_path)"
APPDIR="$(cd -P "$DEPLOY_DIR/.." && pwd)"
TEMPLATE="$DEPLOY_DIR/com.rocket.onair.plist.template"

# --- the service's home inside the four-part layout (D-37). Named once, here, so a
# future move is one edit rather than a grep. ENTRY is what the plist launches, and
# what plist_is_stale compares the installed plist against. ---
SERVER_DIR="${ONAIR_SERVER_DIR:-$APPDIR/server}"
ENTRY="$SERVER_DIR/dist/index.js"
DIST_DIR="$SERVER_DIR/dist"
DIST_NEXT="$SERVER_DIR/.dist-next"
DIST_PREV="$SERVER_DIR/dist.prev"
DIST_FAILED="$SERVER_DIR/.dist-failed"

# --- resolve the real (non-root) target user + home, whether invoked directly or via sudo ---
CURRENT_USER="$(id -un)"
if [[ "$CURRENT_USER" == "root" && -n "${SUDO_USER:-}" ]]; then TARGET_USER="$SUDO_USER"; else TARGET_USER="$CURRENT_USER"; fi
TARGET_HOME="$(dscl . -read "/Users/$TARGET_USER" NFSHomeDirectory 2>/dev/null | awk '{print $2}')"
if [[ -z "$TARGET_HOME" ]]; then TARGET_HOME="$HOME"; fi

# --- config: a real env var wins over ~/.onair/config.env, which wins over
# the defaults. The config file is NEVER sourced or eval'd (it's user-
# writable, and this runs as root under sudo) - only `KEY=value` lines are
# parsed with grep/cut, with one pair of surrounding quotes stripped. ---
CONFIG_FILE="${ONAIR_CONFIG:-$TARGET_HOME/.onair/config.env}"

# read_config KEY - prints env var KEY if set (non-empty), else the value of
# the LAST matching `^KEY=` line in $CONFIG_FILE with one pair of surrounding
# single/double quotes stripped, else nothing.
read_config() {
  local key="$1" line value
  local env_value="${!key:-}"
  if [[ -n "$env_value" ]]; then
    printf '%s' "$env_value"
    return 0
  fi
  [[ -f "$CONFIG_FILE" ]] || return 0
  line="$(grep "^${key}=" "$CONFIG_FILE" 2>/dev/null | tail -n 1)"
  [[ -n "$line" ]] || return 0
  value="$(printf '%s\n' "$line" | cut -d'=' -f2-)"
  case "$value" in
    \"*\") value="${value#\"}"; value="${value%\"}" ;;
    \'*\') value="${value#\'}"; value="${value%\'}" ;;
  esac
  printf '%s' "$value"
}

# read_config_file KEY - like read_config, but reads ONLY the file, never the environment.
#
# Needed by `setup`, which REWRITES config.env from scratch. read_config prefers a real
# environment variable, so using it to carry an existing line forward would bake whatever
# happened to be exported in the invoking shell into the file on disk - turning a
# per-invocation override into a permanent one, silently. (#47)
read_config_file() {
  local key="$1" line value
  [[ -f "$CONFIG_FILE" ]] || return 0
  line="$(grep "^${key}=" "$CONFIG_FILE" 2>/dev/null | tail -n 1)"
  [[ -n "$line" ]] || return 0
  value="$(printf '%s\n' "$line" | cut -d'=' -f2-)"
  case "$value" in
    \"*\") value="${value#\"}"; value="${value%\"}" ;;
    \'*\') value="${value#\'}"; value="${value%\'}" ;;
  esac
  printf '%s' "$value"
}

# valid_port ARG - true if ARG is an integer in 1-65535.
valid_port() {
  local p="$1"
  [[ "$p" =~ ^[0-9]+$ ]] || return 1
  (( p >= 1 && p <= 65535 ))
}

ONAIR_PORT="$(read_config ONAIR_PORT)"
ONAIR_PORT="${ONAIR_PORT:-8484}"
ONAIR_TOKEN="$(read_config ONAIR_TOKEN)"
STATE_FILE="$(read_config ONAIR_STATE_FILE)"
STATE_FILE="${STATE_FILE:-$TARGET_HOME/.onair/state.json}"
LOG_FILE="$TARGET_HOME/.onair/logs/onair.log"

usage() {
  cat >&2 <<EOF
usage: onair <verb> [args]

verbs:
  install [--sudoers]  render plist, install to launchd, bootstrap (runs
                        setup first if $CONFIG_FILE doesn't exist yet)
  setup [--non-interactive]
                        interactive Q&A for port/state file; writes
                        $CONFIG_FILE (0600); restarts if the daemon is up.
                        This edits the ENV OVERLAY, which is the escape hatch
                        for a host whose service will not boot - not the
                        service's configuration. Everything else (state table,
                        bind mode, passphrase, device credentials) lives in
                        ~/.onair/config.json and is edited in the admin console.
  uninstall            bootout, remove plist/newsyslog/symlink/sudoers
  start                bootstrap if not loaded, else kickstart
  stop                 bootout (returns at next boot; see 'disable')
  restart              kickstart -k
  reload               bootout+bootstrap (plist/env changes; kickstart -k
                        alone does not re-read the plist)
  ui [--open]           print the URLs this system serves - admin console,
                        public display, and the panel's own status page when a
                        device is configured. --open launches the console.
  status                supervised + responding two-layer check
  logs [-f]             tail (or follow) $LOG_FILE
  reset-state            clear on-air state via API (or state file), restart
  disable               launchctl disable (persists across reboot)
  enable                launchctl enable, then start
  update [--check-only|--dry-run] [--yes]
                        fetch + fast-forward this checkout, rebuild, swap in
                        the new dist, restart (reload if the node path
                        changed), health-poll; rolls back on failure.
                        --check-only/--dry-run lists pending commits without
                        applying. --yes skips the confirm prompt (implied
                        when stdin is not a TTY). Refuses a dirty tree or a
                        checkout with no upstream branch.

Reads ONAIR_PORT (default 8484) and ONAIR_TOKEN from the environment or
$CONFIG_FILE. Both are OVERLAY values: a real environment variable wins over the
file, and the file wins over ~/.onair/config.json - which is the config document
the service actually reads. ONAIR_TOKEN overrides the passphrase, so a line left
in $CONFIG_FILE will keep reverting a rotation done in the admin console.
EOF
}

# --- health check: GET /admin/health, token via Authorization: Bearer header ---
# (not a query string - an unencoded token containing # or & would otherwise
# corrupt the URL; the header form works fine for GETs too).
health_check_once() {
  local -a auth=()
  if [[ -n "$ONAIR_TOKEN" ]]; then
    auth=(-H "Authorization: Bearer $ONAIR_TOKEN")
  fi
  curl -fsS -m 2 "${auth[@]+"${auth[@]}"}" "http://localhost:$ONAIR_PORT/admin/health" >/dev/null 2>&1
}

# Fetches /admin/health and prints its body, or nothing on failure. Kept
# dependency-free (grep, not a JSON parser) since the only field we care
# about is stateFileWritable.
health_body() {
  local -a auth=()
  if [[ -n "$ONAIR_TOKEN" ]]; then
    auth=(-H "Authorization: Bearer $ONAIR_TOKEN")
  fi
  curl -fsS -m 2 "${auth[@]+"${auth[@]}"}" "http://localhost:$ONAIR_PORT/admin/health" 2>/dev/null
}

# Every mutating verb polls up to 5s and prints PASS/FAIL. Also fails (even
# though the HTTP check passed) when the health body reports
# stateFileWritable:false - that's the daemon-can't-persist-state failure
# mode (e.g. a root-owned ~/.onair from a bad install), and a poll that
# ignores it would report PASS while writes silently fail.
mutating_health_poll() {
  local deadline=$((SECONDS + 5))
  local body
  while (( SECONDS < deadline )); do
    if body="$(health_body)" && [[ -n "$body" ]]; then
      if printf '%s' "$body" | grep -q '"stateFileWritable":false'; then
        echo "health: FAIL (stateFileWritable is false - state directory not writable by the daemon)"
        return 1
      fi
      echo "health: PASS"
      return 0
    fi
    sleep 0.5
  done
  echo "health: FAIL"
  return 1
}

# --- launchctl wrappers ---
sudo_launchctl() {
  sudo "$LAUNCHCTL" "$@"
}

is_loaded() {
  sudo_launchctl print "$T" >/dev/null 2>&1
}

# ensure_target_dir DIR - mkdir -p as TARGET_USER, whether invoked directly
# or via sudo. A plain root-owned mkdir under sudo would leave the directory
# unwritable by the daemon, which always runs as TARGET_USER.
ensure_target_dir() {
  local dir="$1"
  if [[ "$(id -u)" -eq 0 ]]; then
    sudo -u "$TARGET_USER" mkdir -p "$dir"
  else
    mkdir -p "$dir"
  fi
}

# One-time migration: the config file used to be ~/.onair/cli.env. If it
# exists and the new ~/.onair/config.env doesn't, copy it over (owner
# TARGET_USER, mode 0600) and say so. cli.env is not read after this.
migrate_cli_env() {
  local cli_env="$TARGET_HOME/.onair/cli.env"
  local config_env="$TARGET_HOME/.onair/config.env"
  if [[ -f "$cli_env" && ! -f "$config_env" ]]; then
    install -o "$TARGET_USER" -m 0600 "$cli_env" "$config_env"
    echo "onair: migrated $cli_env to $config_env"
  fi
}

# render_plist_to DEST - render the plist template (node/APPDIR/user/home
# placeholders) into DEST and lint it. The whole render, and nothing privileged:
# split out of render_plist so the byte-for-byte verification can run it into a
# scratch file without sudo and without touching /Library.
render_plist_to() {
  local dest="$1"
  local node_bin
  node_bin="$(command -v node || true)"
  if [[ -z "$node_bin" ]]; then
    echo "onair: node not found in PATH - install failed" >&2
    exit 1
  fi

  if [[ ! -f "$TEMPLATE" ]]; then
    echo "onair: template not found at $TEMPLATE" >&2
    exit 1
  fi

  local sub_value
  for sub_value in "$node_bin" "$APPDIR" "$TARGET_USER" "$TARGET_HOME"; do
    if [[ "$sub_value" == *'&'* || "$sub_value" == *'|'* || "$sub_value" == *'\'* ]]; then
      echo "onair: path contains characters the installer cannot render safely" >&2
      exit 1
    fi
  done

  # This is the exact sed pipeline used to render the template; verification
  # reproduces it byte-for-byte against a scratch dir.
  sed \
    -e "s|@NODE@|$node_bin|g" \
    -e "s|@APPDIR@|$APPDIR|g" \
    -e "s|@USER@|$TARGET_USER|g" \
    -e "s|@HOME@|$TARGET_HOME|g" \
    "$TEMPLATE" > "$dest"

  if ! plutil -lint "$dest" >/dev/null; then
    echo "onair: rendered plist failed plutil -lint" >&2
    rm -f "$dest"
    exit 1
  fi
}

# render_plist - render, then install to $PLIST_PATH (0644 root:wheel). Factored out
# of cmd_install so `onair update`'s stale-plist path (step 7) can re-render without
# going through cmd_install's full flow (wizard-on-first-run, sudoers, bootstrap-start).
render_plist() {
  local tmp_plist
  tmp_plist="$(mktemp /tmp/com.rocket.onair.plist.XXXXXX)"
  render_plist_to "$tmp_plist"
  sudo install -o root -g wheel -m 0644 "$tmp_plist" "$PLIST_PATH"
  rm -f "$tmp_plist"
}

# plist_is_stale PLIST [WANT_NODE] [WANT_ENTRY] - true when the installed plist no
# longer describes how this checkout should be launched, so it MUST be re-rendered
# before the daemon is restarted. Two causes, indistinguishable from the daemon's
# side because both end the same way - launchd execs a path that is not there and
# KeepAlive respawns into the same failure forever:
#
#   1. the node binary moved (a Homebrew upgrade)
#   2. the entry point moved - D-37 put the service under server/, so a plist
#      installed before that migration still names $APPDIR/dist/index.js
#
# Returns FALSE for an absent or unreadable plist. Deliberate: "I cannot read it" is
# not "it is wrong", and re-rendering on a failed read would turn a transient
# PlistBuddy hiccup into an unasked-for privileged write.
plist_is_stale() {
  local plist="$1"
  local want_node="${2:-$(command -v node || true)}"
  local want_entry="${3:-$ENTRY}"
  local installed_node installed_entry
  [[ -f "$plist" ]] || return 1
  # Branch on PlistBuddy's EXIT STATUS, not on whether it printed something.
  # PlistBuddy writes "Error Reading File: ..." to STDOUT and exits 1, so a corrupt
  # plist hands back a non-empty string that compares unequal to the wanted path and
  # looks exactly like a stale one. An emptiness check alone would answer "stale" for
  # an unreadable file and send `update` off to do a privileged re-render on the
  # strength of a parse error. Caught by deploy/test-update.sh.
  installed_node="$(/usr/libexec/PlistBuddy -c 'Print :ProgramArguments:0' "$plist" 2>/dev/null)" || return 1
  installed_entry="$(/usr/libexec/PlistBuddy -c 'Print :ProgramArguments:1' "$plist" 2>/dev/null)" || return 1
  [[ -n "$installed_node" && -n "$installed_entry" && -n "$want_node" ]] || return 1
  if [[ "$installed_node" != "$want_node" ]]; then
    echo "onair: update: node path changed ($installed_node -> $want_node)" >&2
    return 0
  fi
  if [[ "$installed_entry" != "$want_entry" ]]; then
    echo "onair: update: entry point moved ($installed_entry -> $want_entry) - old-shape plist" >&2
    return 0
  fi
  return 1
}

# run_as_invoking_user CMD... - runs CMD as $SUDO_USER when this script is
# running as root under sudo (so `onair update`'s git/npm/build steps don't
# leave root-owned files in the checkout); runs it directly otherwise. -H so
# npm/node/git see the invoking user's HOME, not root's. Mirrors
# deploy/bootstrap's helper of the same name.
run_as_invoking_user() {
  if [[ "$(id -u)" -eq 0 && -n "${SUDO_USER:-}" ]]; then
    sudo -u "$SUDO_USER" -H "$@"
  else
    "$@"
  fi
}

# git_u ARGS... - git against $APPDIR, run as the invoking (non-root) user.
git_u() {
  run_as_invoking_user git -C "$APPDIR" "$@"
}

# dist_is_current - true if $DIST_DIR exists and no file under $SERVER_DIR/src has a
# newer mtime than it.
dist_is_current() {
  [[ -d "$DIST_DIR" ]] || return 1
  local newer
  newer="$(find "$SERVER_DIR/src" -type f -newer "$DIST_DIR" 2>/dev/null)"
  [[ -z "$newer" ]]
}

# swap_dist_in - move the staged build at $DIST_NEXT into $DIST_DIR, keeping the
# outgoing one at $DIST_PREV for rollback. The trap is deliberately scoped to just
# the two `mv`s: if a kill lands between them, $DIST_DIR would otherwise be left
# missing entirely and KeepAlive would respawn into nothing.
swap_dist_in() {
  trap '
    if [[ ! -d "$DIST_DIR" && -d "$DIST_PREV" ]]; then
      echo "onair: update: interrupted mid-swap - restoring dist from dist.prev" >&2
      mv "$DIST_PREV" "$DIST_DIR"
    fi
    exit 1
  ' INT TERM ERR
  rm -rf "$DIST_PREV"
  if [[ -d "$DIST_DIR" ]]; then
    mv "$DIST_DIR" "$DIST_PREV"
  fi
  mv "$DIST_NEXT" "$DIST_DIR"
  trap - INT TERM ERR
}

# roll_dist_back - put the pre-update build back and keep the bad one for diagnosis.
# Returns non-zero when there is nothing to roll back to, which is a materially
# different situation and must not be reported as a successful rollback.
roll_dist_back() {
  if [[ ! -d "$DIST_PREV" ]]; then
    echo "onair: update: no dist.prev to roll back to - $DIST_DIR left as the failed build" >&2
    return 1
  fi
  rm -rf "$DIST_FAILED"
  mv "$DIST_DIR" "$DIST_FAILED"
  mv "$DIST_PREV" "$DIST_DIR"
  echo "onair: update: failed build kept at $DIST_FAILED for diagnosis" >&2
  return 0
}

# ---------------------------------------------------------------------------
cmd_install() {
  local sudoers_flag="${1:-}"
  # Create as TARGET_USER, not root: install runs under sudo, so a plain
  # `mkdir -p` here would leave ~/.onair root-owned and the daemon (which runs
  # as TARGET_USER) unable to write state. Works both invoked via sudo (EUID
  # 0, TARGET_USER set from SUDO_USER) and run directly (EUID != 0, plain mkdir).
  ensure_target_dir "$TARGET_HOME/.onair/logs"

  migrate_cli_env

  # A fresh install with no config.env yet (and nothing to migrate from
  # cli.env) gets the wizard before the daemon ever starts, so the first
  # boot already uses the chosen values instead of defaults. Interactive
  # only on a TTY - cmd_setup makes that call itself.
  if [[ ! -f "$CONFIG_FILE" ]]; then
    cmd_setup __internal_from_install__
  fi

  render_plist

  write_newsyslog_conf

  sudo ln -sf "$DEPLOY_DIR/onair" "$BIN_LINK"

  sudo_launchctl bootstrap system "$PLIST_PATH"

  if [[ "$sudoers_flag" == "--sudoers" ]]; then
    install_sudoers
  fi

  mutating_health_poll
}

write_newsyslog_conf() {
  local tmp
  tmp="$(mktemp /tmp/onair.newsyslog.XXXXXX)"
  cat > "$tmp" <<EOF
# logfilename                          [owner:group]    mode count size  when  flags
$LOG_FILE   $TARGET_USER:staff       644  5     10000 *     J
EOF
  sudo install -o root -g wheel -m 0644 "$tmp" "$NEWSYSLOG_CONF"
  rm -f "$tmp"
}

install_sudoers() {
  local tmp
  tmp="$(mktemp /tmp/onair.sudoers.XXXXXX)"
  cat > "$tmp" <<EOF
# Managed by 'onair install --sudoers'. Scopes passwordless sudo to exactly the
# launchctl subcommands the onair CLI issues against $LABEL - nothing broader.
# Remove with: sudo rm $SUDOERS_FILE
$TARGET_USER ALL=(root) NOPASSWD: $LAUNCHCTL bootstrap system $PLIST_PATH, \\
  $LAUNCHCTL bootout $T, \\
  $LAUNCHCTL kickstart $T, \\
  $LAUNCHCTL kickstart -k $T, \\
  $LAUNCHCTL print $T, \\
  $LAUNCHCTL enable $T, \\
  $LAUNCHCTL disable $T
EOF
  if ! visudo -cf "$tmp" >/dev/null; then
    echo "onair: generated sudoers file failed visudo -cf, not installing" >&2
    rm -f "$tmp"
    exit 1
  fi
  sudo install -o root -g wheel -m 0440 "$tmp" "$SUDOERS_FILE"
  rm -f "$tmp"
}

cmd_setup() {
  local non_interactive=false
  local from_install=false
  local a
  for a in "$@"; do
    case "$a" in
      --non-interactive) non_interactive=true ;;
      __internal_from_install__) from_install=true ;;
      *)
        echo "onair: setup: unknown argument: $a" >&2
        exit 1
        ;;
    esac
  done

  ensure_target_dir "$(dirname "$CONFIG_FILE")"
  migrate_cli_env

  # Current effective values (env > config file > built-in default). Read
  # fresh here since migrate_cli_env may have just created config.env.
  local cur_port cur_state
  cur_port="$(read_config ONAIR_PORT)"; cur_port="${cur_port:-8484}"
  cur_state="$(read_config ONAIR_STATE_FILE)"; cur_state="${cur_state:-$TARGET_HOME/.onair/state.json}"

  # THE TOKEN IS NOT ASKED ABOUT ANY MORE (#47). It is the passphrase now (D-35), it lives
  # in ~/.onair/config.json, and it is rotated in the admin console with a grace window
  # (D-51). Writing it here PINNED it: ONAIR_TOKEN in this overlay overrides
  # config.auth.passphrase at boot (D-14, server/src/app.ts), so a rotation in the console
  # survived exactly until the next restart and nothing said so.
  #
  # Only to decide whether to WARN. The line itself is carried forward by the rewrite
  # below, along with every other key setup does not own. Read from the FILE, not through
  # read_config: a token merely exported in the invoking shell is not one on disk, and
  # confusing the two is how a per-run override becomes a permanent one.
  local existing_token
  existing_token="$(read_config_file ONAIR_TOKEN)"

  local new_port="$cur_port" new_state="$cur_state"

  local interactive=false
  if [[ -t 0 && "$non_interactive" != "true" ]]; then
    interactive=true
  fi

  if [[ "$interactive" == "true" ]]; then
    local ans

    # `read -r` returns nonzero on EOF; under `set -e` that would kill the
    # script mid-wizard if stdin closes early, so every read is guarded with
    # `|| true` and validated afterward instead of trusted to succeed.

    while true; do
      read -r -p "Port [$cur_port]: " ans || true
      ans="${ans:-$cur_port}"
      if valid_port "$ans"; then
        new_port="$ans"
        break
      fi
      echo "onair: invalid port '$ans' - must be an integer 1-65535" >&2
    done

    read -r -p "State file [$cur_state]: " ans || true
    new_state="${ans:-$cur_state}"
  else
    # Non-interactive path: the wizard's per-keystroke valid_port check never
    # runs, so an env/config ONAIR_PORT that isn't a valid port would
    # otherwise sail straight into config.env unchecked.
    if ! valid_port "$new_port"; then
      echo "onair: invalid ONAIR_PORT '$new_port' - must be an integer 1-65535" >&2
      exit 1
    fi
  fi

  # Was the daemon reachable before config.env changes under it? Probed with
  # curl (health_check_once), deliberately NOT is_loaded/launchctl - launchctl
  # needs sudo, and setup must stay sudo-free when the daemon is down. This
  # uses the CURRENT $ONAIR_PORT/$ONAIR_TOKEN (read at script startup, before
  # this function reassigns them below), i.e. what the daemon is actually
  # listening on right now.
  local daemon_was_up=false
  if health_check_once; then
    daemon_was_up=true
  fi

  # SETUP OWNS TWO KEYS AND CARRIES EVERYTHING ELSE FORWARD VERBATIM (#47).
  #
  # It used to rewrite this file from scratch, which silently DELETED every key it did not
  # know about. Measured against a copy of this host's real overlay: one run dropped
  # ONAIR_LIGHT_HOST, ONAIR_LIGHT_ENTITY, ONAIR_LIGHT_USER and ONAIR_LIGHT_PASS - the four
  # lines D-56's migration note says are what actually hold the device credential on this
  # machine. A verb advertised as "re-runnable any time" must not do that.
  #
  # So the managed keys live between markers and everything outside them is the operator's,
  # comments included. Re-running strips the old block by marker and writes a fresh one,
  # which makes this idempotent rather than accumulating.
  local tmp_config carried
  tmp_config="$(mktemp /tmp/onair.config.XXXXXX)"
  carried="$(mktemp /tmp/onair.carried.XXXXXX)"
  : > "$carried"
  if [[ -f "$CONFIG_FILE" ]]; then
    # Drop the previous managed block, then any stray assignment to a managed key left
    # over from before the markers existed. Nothing else is touched.
    awk '
      /^# >>> managed by .onair setup./ { skip = 1; next }
      /^# <<< end managed/             { skip = 0; next }
      skip                              { next }
      /^ONAIR_PORT=/                    { next }
      /^ONAIR_STATE_FILE=/              { next }
      { print }
    ' "$CONFIG_FILE" > "$carried"
  fi

  {
    echo "# $CONFIG_FILE - the onair ENV OVERLAY."
    echo "#"
    echo "# NOT the service's configuration. The config document is ~/.onair/config.json"
    echo "# (D-50) and holds the state table, the bind mode, the passphrase and the device"
    echo "# credentials; the admin console edits it. This file exists to OVERRIDE that"
    echo "# document from the environment, which is how you unbrick a host whose service"
    echo "# will not boot (D-14). A real environment variable still wins over this file."
    echo "#"
    echo "# ONAIR_TOKEN here overrides auth.passphrase, so a line left in this file will"
    echo "# keep reverting a rotation done in the console. 'onair setup' never writes one."
    echo "# >>> managed by 'onair setup' - rerun it to change these"
    printf 'ONAIR_PORT="%s"\n' "$new_port"
    printf 'ONAIR_STATE_FILE="%s"\n' "$new_state"
    echo "# <<< end managed - everything below is yours and setup does not touch it"
    cat "$carried"
  } > "$tmp_config"

  install -o "$TARGET_USER" -m 0600 "$tmp_config" "$CONFIG_FILE"
  rm -f "$tmp_config" "$carried"
  echo "onair: wrote $CONFIG_FILE"

  # The rest of this run (restart/health-poll below, or cmd_install's own
  # flow if we were called from there) should see the values just written.
  # ONAIR_TOKEN is deliberately NOT reassigned - this function no longer changes it, and
  # the value read at startup is still the one the daemon is authenticating with.
  ONAIR_PORT="$new_port"
  STATE_FILE="$new_state"

  if [[ -n "$existing_token" ]]; then
    echo "onair: NOTE - $CONFIG_FILE sets ONAIR_TOKEN, which overrides auth.passphrase in" >&2
    echo "onair: ~/.onair/config.json. Rotating the passphrase in the admin console will be" >&2
    echo "onair: reverted at the next restart until you remove that line. Kept as you left it." >&2
  else
    echo "onair: the passphrase is not configured here - it lives in ~/.onair/config.json"
    echo "onair: and is rotated in the admin console at http://localhost:$new_port/"
  fi

  if [[ "$from_install" == "true" ]]; then
    return 0
  fi

  if [[ "$daemon_was_up" == "true" ]]; then
    cmd_restart
  else
    echo "onair: daemon not responding - check 'onair status' and 'onair logs'; if it's not installed yet, run 'sudo onair install'"
  fi
}

cmd_uninstall() {
  if is_loaded; then
    sudo_launchctl bootout "$T"
  fi
  sudo rm -f "$PLIST_PATH" "$NEWSYSLOG_CONF" "$SUDOERS_FILE" "$BIN_LINK"
  mutating_health_poll || true
}

cmd_start() {
  if is_loaded; then
    sudo_launchctl kickstart "$T"
  else
    sudo_launchctl bootstrap system "$PLIST_PATH"
  fi
  mutating_health_poll
}

cmd_stop() {
  sudo_launchctl bootout "$T"
  echo "returns at next boot; use \`onair disable\` for persistent off"
  mutating_health_poll || true
}

cmd_restart() {
  sudo_launchctl kickstart -k "$T"
  mutating_health_poll
}

cmd_reload() {
  echo "reload: 'kickstart -k' restarts the process but does not re-read the" >&2
  echo "plist from disk; reload does bootout+bootstrap so plist/env changes" >&2
  echo "(e.g. after re-running install) actually take effect." >&2
  if is_loaded; then
    sudo_launchctl bootout "$T"
  fi
  sudo_launchctl bootstrap system "$PLIST_PATH"
  mutating_health_poll
}

cmd_status() {
  # THREE states, not two (#45). `no` is a CLAIM - this daemon is not supervised - and it
  # can only be made once the question has actually been asked. Without a cached sudo
  # ticket or the `--sudoers` rule we cannot ask, and the old code reported that as `no`:
  # a live, launchd-supervised service read as unsupervised, and the exit rule at the
  # bottom acted on it. The comment below already described the intended behaviour; the
  # code disagreed with it, and the code was the one that was wrong.
  local supervised=unknown state="unknown" pid="unknown" last_exit="unknown" disabled="unknown"
  local print_out="" sudo_err=""
  sudo_err="$(mktemp /tmp/onair.status.XXXXXX)"
  # -n: never prompt for a password. Without a cached/NOPASSWD sudo ticket,
  # status degrades to "supervised: unknown" instead of hanging or exiting 1.
  #
  # Telling the two failures apart: sudo prefixes its OWN diagnostics with `sudo: ` and
  # launchctl does not. That prefix is not localised, so this does not depend on the
  # locale the way matching "a password is required" would.
  if print_out="$(sudo -n "$LAUNCHCTL" print "$T" 2>"$sudo_err")"; then
    supervised=yes
    state="$(printf '%s\n' "$print_out" | awk -F' = ' '/^[[:space:]]*state = /{print $2; exit}')"
    pid="$(printf '%s\n' "$print_out" | awk -F' = ' '/^[[:space:]]*pid = /{print $2; exit}')"
    last_exit="$(printf '%s\n' "$print_out" | awk -F' = ' '/last exit (code|status) = /{print $2; exit}')"
    if printf '%s\n' "$print_out" | grep -qE 'disabled = (1|true)'; then
      disabled=yes
    elif printf '%s\n' "$print_out" | grep -qE 'disabled = (0|false)'; then
      disabled=no
    fi
    [[ -z "$state" ]] && state="unknown" || true
    [[ -z "$pid" ]] && pid="unknown" || true
    [[ -z "$last_exit" ]] && last_exit="unknown" || true
  elif grep -q 'sudo:' "$sudo_err"; then
    supervised=unknown
  else
    # sudo ran and launchctl answered no. That is a real answer.
    supervised=no
  fi
  rm -f "$sudo_err"

  local responding=no
  if health_check_once; then
    responding=yes
  fi

  if [[ "$supervised" == unknown ]]; then
    # The detail fields are meaningless here - nothing was read - so they are not
    # printed. A line of `unknown`s reads like an answer and this is not one.
    echo "supervised: unknown - could not ask (needs a sudo ticket, or 'onair install --sudoers')"
  else
    echo "supervised: $supervised (state=$state pid=$pid last-exit=$last_exit disabled=$disabled)"
  fi
  echo "responding: $responding"

  # "Nothing proves this is up" is the failure, not "supervised == no". A not-yet-
  # installed/unauthorized daemon that's still answering on the port (e.g. run by hand)
  # is healthy - and a daemon that is NOT answering still fails when supervision could
  # not be checked, which is the one behaviour worth keeping from the two-state version.
  if [[ "$supervised" != yes && "$responding" == no ]]; then
    return 1
  fi
  return 0
}

cmd_ui() {
  local open_it=false
  case "${1:-}" in
    "") ;;
    --open) open_it=true ;;
    *) echo "onair: ui: unknown argument: $1" >&2; exit 1 ;;
  esac

  local console="http://localhost:$ONAIR_PORT/"

  echo "admin console:  $console"
  echo "public display: http://localhost:$ONAIR_PORT/display"

  # The panel's own pages (#33). Resolved from the env overlay first because that is what
  # the service itself would honour (D-14); the config document is the fallback, not the
  # other way round, so this cannot claim a host the daemon is not actually using.
  local light_host
  light_host="$(read_config ONAIR_LIGHT_HOST)"
  if [[ -z "$light_host" ]]; then
    # Read with node rather than grepped out of the JSON: `onair` already requires node
    # (the plist launches it), and a regex over somebody's config document is the kind of
    # shortcut that works until a value contains a brace. Failure here is not an error -
    # no device configured is a normal state.
    light_host="$(node -e '
      const { readFileSync } = require("node:fs");
      try { process.stdout.write(String(JSON.parse(readFileSync(process.argv[1], "utf8")).light?.host ?? "")); }
      catch { }
    ' "$TARGET_HOME/.onair/config.json" 2>/dev/null || true)"
  fi
  if [[ -n "$light_host" ]]; then
    echo "panel status:   http://$light_host/onair"
    echo "panel config:   http://$light_host/onair/config"
  else
    echo "panel:          no device configured (set it in the admin console)"
  fi

  if [[ "$open_it" == "true" ]]; then
    if command -v open >/dev/null 2>&1; then
      open "$console"
    elif command -v xdg-open >/dev/null 2>&1; then
      xdg-open "$console"
    else
      # Not an error. The URLs are printed above, which was the point of the verb; --open
      # is a convenience and a missing opener is not a failed command.
      echo "onair: no 'open' or 'xdg-open' on this host - the URL is above" >&2
    fi
  fi
}

cmd_logs() {
  local follow="${1:-}"
  if [[ ! -f "$LOG_FILE" ]]; then
    echo "onair: no log file at $LOG_FILE yet" >&2
    exit 1
  fi
  if [[ "$follow" == "-f" ]]; then
    tail -f "$LOG_FILE"
  else
    tail -n 100 "$LOG_FILE"
  fi
}

cmd_reset_state() {
  if health_check_once; then
    local -a auth=()
    if [[ -n "$ONAIR_TOKEN" ]]; then
      auth=(-H "Authorization: Bearer $ONAIR_TOKEN")
    fi
    # "${auth[@]+"${auth[@]}"}" (not bare "${auth[@]}"): bash 3.2 - macOS's
    # /bin/bash - throws "unbound variable" expanding an empty array under
    # `set -u` without this guard.
    curl -fsS -m 2 -X POST "${auth[@]+"${auth[@]}"}" "http://localhost:$ONAIR_PORT/off" >/dev/null || true
    curl -fsS -m 2 -X DELETE "${auth[@]+"${auth[@]}"}" "http://localhost:$ONAIR_PORT/message" >/dev/null || true
  else
    rm -f "$STATE_FILE"
  fi
  sudo_launchctl kickstart -k "$T"
  mutating_health_poll
}

cmd_disable() {
  sudo_launchctl disable "$T"
  mutating_health_poll || true
}

cmd_enable() {
  sudo_launchctl enable "$T"
  cmd_start
}

# apply_restart_for_update - steps 7-8 of `onair update`: on Mac, if the installed
# plist no longer matches this checkout (see plist_is_stale), re-render it and
# reload - a plain `restart` would kickstart the process without re-reading the
# plist, so it would relaunch into the same wrong path. Otherwise a plain restart.
# Both cmd_reload and cmd_restart already end in mutating_health_poll (PASS/FAIL
# printed there) - this function's exit status IS the health-poll result, for
# cmd_update to branch on.
apply_restart_for_update() {
  if [[ "$(uname -s)" == "Darwin" ]] && plist_is_stale "$PLIST_PATH"; then
    echo "onair: update: re-rendering plist and reloading" >&2
    render_plist
    cmd_reload
    return
  fi
  cmd_restart
}

# cmd_update [--check-only|--dry-run] [--yes] - self-update: fetch, fast-
# forward if behind, rebuild into a staging dir, swap it in, restart
# (reload if the node path changed), health-poll, roll back on failure. See
# docs/superpowers/specs/2026-08-06-host-install-evolvable-design.md
# Deliverable 5 for the numbered steps this mirrors.
cmd_update() {
  local check_only=false yes=false
  local a
  for a in "$@"; do
    case "$a" in
      --check-only|--dry-run) check_only=true ;;
      --yes) yes=true ;;
      *)
        echo "onair: update: unknown argument: $a" >&2
        exit 1
        ;;
    esac
  done
  # Non-interactive invocations (cron, CI, a pipe) can't answer a confirm
  # prompt - treat as if --yes were passed rather than hang.
  [[ -t 0 ]] || yes=true

  if ! git_u rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "onair: update: $APPDIR is not a git checkout - can't self-update" >&2
    exit 1
  fi
  if ! git_u rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    echo "onair: update: no upstream tracking branch configured for the current branch in $APPDIR - can't self-update" >&2
    exit 1
  fi

  # Step 1: refuse a dirty tree - staged or unstaged changes to tracked
  # files (untracked files don't block a fast-forward merge, so they're not
  # treated as blocking here).
  local dirty
  dirty="$( { git_u diff --name-only; git_u diff --cached --name-only; } | sort -u )"
  if [[ -n "$dirty" ]]; then
    echo "onair: update: refusing - working tree has uncommitted changes:" >&2
    printf '%s\n' "$dirty" >&2
    exit 1
  fi

  # Step 2: fetch, then check both "no new commits" and "dist is current" -
  # a stale/missing dist with no new commits still needs a rebuild, just
  # without a merge first.
  git_u fetch --quiet origin

  local head_rev upstream_rev
  head_rev="$(git_u rev-parse @)"
  upstream_rev="$(git_u rev-parse '@{u}')"

  if [[ "$head_rev" == "$upstream_rev" ]] && dist_is_current; then
    echo "Everything is up to date."
    exit 0
  fi

  # Step 3: --check-only/--dry-run stops here, before touching anything.
  if [[ "$check_only" == "true" ]]; then
    local log
    log="$(git_u log --oneline '@..@{u}')"
    if [[ -n "$log" ]]; then
      printf '%s\n' "$log"
    else
      echo "no new commits"
    fi
    exit 0
  fi

  # Step 4: confirm unless --yes (or non-TTY, handled above).
  if [[ "$yes" != "true" ]]; then
    local ans
    read -r -p "Apply update and restart onair? [y/N] " ans || true
    case "$ans" in
      y|Y|yes|Yes) ;;
      *)
        echo "onair: update: aborted" >&2
        exit 1
        ;;
    esac
  fi

  # Step 5: fast-forward (skip if already at the upstream commit) + npm ci,
  # both as the checkout-owning user even if `update` itself was run via sudo.
  if [[ "$head_rev" != "$upstream_rev" ]]; then
    git_u merge --ff-only '@{u}'
  fi
  # npm ci at the ROOT: the workspaces (D-37) are installed as one tree, and
  # running it inside server/ would miss the other two and rewrite the root lock.
  ( cd "$APPDIR" && run_as_invoking_user npm ci --ignore-scripts )

  # Step 6: build to a staging dir, then swap it in.
  rm -rf "$DIST_NEXT"
  ( cd "$SERVER_DIR" && run_as_invoking_user npx tsc -p tsconfig.json --outDir .dist-next )

  # The admin console is a static asset under server/public, not part of dist, so it is
  # rebuilt in place rather than staged. It is regenerated wholly on every update and the
  # server re-reads it per request, so a stale or half-written one cannot outlive this.
  # Skipping it would leave `onair update` serving yesterday's console with no symptom
  # except that a fix did not appear.
  ( cd "$APPDIR" && run_as_invoking_user npm run build --workspace admin-ui )

  swap_dist_in

  # Steps 7-8: restart (or reload, if node moved) + health-poll.
  if apply_restart_for_update; then
    return 0
  fi

  # Health failed: roll back to the pre-update build, keep the bad one
  # around for diagnosis, restart once more (best-effort - the update has
  # already failed regardless of whether this second restart's poll passes).
  echo "onair: update: health check failed after update - rolling back" >&2
  if roll_dist_back; then
    apply_restart_for_update || true
  fi
  exit 1
}

# ---------------------------------------------------------------------------
# ONAIR_LIB_ONLY=1 sources the functions above without dispatching a verb, so the
# pure ones - render_plist_to, plist_is_stale, swap_dist_in, roll_dist_back - can be
# exercised by deploy/test-update.sh with no sudo and nothing installed. It is a test
# seam and nothing else: every verb below still requires an explicit argument.
if [[ -n "${ONAIR_LIB_ONLY:-}" ]]; then
  return 0 2>/dev/null || exit 0
fi

if [[ $# -lt 1 ]]; then
  usage
  exit 1
fi

verb="$1"
shift

case "$verb" in
  install) cmd_install "${1:-}" ;;
  setup) cmd_setup "$@" ;;
  uninstall) cmd_uninstall ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_restart ;;
  reload) cmd_reload ;;
  status) cmd_status ;;
  ui) cmd_ui "${1:-}" ;;
  logs) cmd_logs "${1:-}" ;;
  reset-state) cmd_reset_state ;;
  disable) cmd_disable ;;
  enable) cmd_enable ;;
  update) cmd_update "$@" ;;
  *)
    usage
    exit 1
    ;;
esac
