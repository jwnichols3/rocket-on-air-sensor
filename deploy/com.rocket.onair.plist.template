<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for /Library/LaunchDaemons/com.rocket.onair.plist.
  Never hand-edit the installed plist - rerun `sudo deploy/onair install` instead,
  which renders this template (sed), lints it (plutil -lint), and installs it
  root:wheel 0644.

  Placeholders (filled in by `onair install`; kept out of this sentence so the
  rendered copy doesn't end up with a self-contradicting comment):
    NODE - absolute path to the node binary (e.g. /opt/homebrew/bin/node)
    APPDIR - absolute path to the app checkout (WorkingDirectory; runs
             APPDIR/dist/index.js)
    USER - macOS username launchd runs the daemon as (UserName)
    HOME - that user's home directory (EnvironmentVariables.HOME, log paths)
  Each is written into the plist below wrapped in '@' signs, e.g. the node
  placeholder reads "at" sign + NODE + "at" sign.

  No service configuration (port, token, state file) lives in this plist or
  the rendered copy: the service reads $HOME/.onair/config.env itself at
  startup (src/config.ts). Change it by editing that file and restarting -
  no re-render of this plist required.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.rocket.onair</string>

	<key>ProgramArguments</key>
	<array>
		<string>@NODE@</string>
		<string>@APPDIR@/dist/index.js</string>
	</array>

	<key>UserName</key>
	<string>@USER@</string>

	<key>WorkingDirectory</key>
	<string>@APPDIR@</string>

	<key>KeepAlive</key>
	<true/>

	<key>RunAtLoad</key>
	<true/>

	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>@HOME@</string>
	</dict>

	<key>StandardOutPath</key>
	<string>@HOME@/.onair/logs/onair.log</string>

	<key>StandardErrorPath</key>
	<string>@HOME@/.onair/logs/onair.log</string>
</dict>
</plist>
